# Log rotation for the WaaS Self-Service Portal v2.
#
# CANDIDATE — not yet installed. Review, then copy to
# /etc/logrotate.d/waas-portal-v2 (root:root 0644).
#
# Two stanzas, because the four files in logs/ have two different writers
# with two different reopen behaviours. Rotating them with one rule would
# silently break one pair or the other.
#
#   gunicorn-access.log, gunicorn-error.log
#       Opened by gunicorn itself (gunicorn.conf.py), running as admin.
#       Gunicorn reopens its log files on SIGUSR1, so these rotate by rename
#       and a signal — no truncation window, no lost writes.
#
#   gunicorn-stderr.log, gunicorn-stdout.log
#       Not written by gunicorn at all. systemd redirects the unit's stdio
#       with StandardOutput=append: / StandardError=append:, opening both as
#       root before dropping to admin — which is why they are root-owned
#       while the other two are not. systemd holds those descriptors open
#       for the life of the service and has no reopen signal, so a rename
#       would leave it writing to the rotated inode and the new file empty
#       until the next restart. copytruncate is not a preference here, it is
#       the only correct option.

/home/admin/waas-ss-portal-v2/logs/gunicorn-access.log
/home/admin/waas-ss-portal-v2/logs/gunicorn-error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 admin admin
    sharedscripts
    postrotate
        # Tell gunicorn to reopen; the arbiter forwards to its workers.
        # --kill-whom=main avoids signalling the worker directly, and the
        # guard keeps a stopped service from turning into a rotation error.
        systemctl kill --kill-whom=main -s USR1 waas-portal-v2 2>/dev/null || true
    endscript
}

/home/admin/waas-ss-portal-v2/logs/gunicorn-stderr.log
/home/admin/waas-ss-portal-v2/logs/gunicorn-stdout.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
