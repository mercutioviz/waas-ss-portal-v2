# Log rotation for the WaaS Self-Service Portal v2.
#
# Installed copy lives at /etc/logrotate.d/waas-portal-v2 (root:root 0644).
# See README.md in this directory for the install and verification steps.
#
# Only two files need rotating here. gunicorn opens both itself (see
# accesslog/errorlog in gunicorn.conf.py), running as admin, and reopens them
# on SIGUSR1 — so they rotate by rename plus a signal, with no truncation
# window and no lost writes.
#
# The unit's own stdout/stderr are deliberately absent. They used to be
# redirected to logs/gunicorn-stdout.log and logs/gunicorn-stderr.log with
# StandardOutput=append: / StandardError=append:, which systemd opens as root
# and then holds for the life of the service with no reopen signal — rotating
# those needed copytruncate. They now go to the journal instead
# (StandardOutput=journal), which journald rotates and vacuums on its own:
#
#     journalctl -u waas-portal-v2 -f
#
# Nothing writes to the two old files any more. If they still exist on disk
# they are historical; archive or remove them by hand.

/home/admin/waas-ss-portal-v2/logs/gunicorn-access.log
/home/admin/waas-ss-portal-v2/logs/gunicorn-error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 admin admin
    sharedscripts
    postrotate
        # Tell gunicorn to reopen; the arbiter forwards to its workers.
        # --kill-whom=main avoids signalling the worker directly, and the
        # guard keeps a stopped service from turning into a rotation error.
        systemctl kill --kill-whom=main -s USR1 waas-portal-v2 2>/dev/null || true
    endscript
}
